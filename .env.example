# ---- Ganga Aarti Booking — environment variables (copy to .env) ----

# Supabase (optional). If BOTH are set, the app uses Supabase for auth + data.
# If they are left empty, the app runs in fully-working LOCAL DEMO MODE
# (data stored in the browser's localStorage, seeded with demo content).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Search Console verification code (the "content" value of the
# google-site-verification meta tag). When set, the app renders:
#   <meta name="google-site-verification" content="<this value>" />
# Get it from Google Search Console > Add property > HTML tag method.
VITE_GSC_VERIFICATION=

# Public origin of the deployed site (used for canonical URLs, sitemap, OG tags).
VITE_SITE_ORIGIN=https://ganga-aarti-wedding.vercel.app

# ---- Server-only (Vercel env, /api/send-push function) — NOT VITE_ vars ----
# Firebase service account for sending push notifications (FCM HTTP v1).
# Firebase Console > Project settings > Service accounts > Generate new
# private key. NEVER commit these values or put them in client code.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Supabase values the server function uses to verify the admin login token.
SUPABASE_URL=
SUPABASE_ANON_KEY=
